# Build de producción (EC2): rutas relativas que Nginx enruta a cada microservicio.
# /api/<servicio>-service/v1/... -> 127.0.0.1:<puerto>/api/v1/...
VITE_AUTH_API_URL=/api/auth-service/v1
VITE_USUARIOS_API_URL=/api/usuario-service/v1
VITE_PRODUCTOS_API_URL=/api/producto-service/v1
VITE_PEDIDOS_API_URL=/api/pedido-service/v1
VITE_METRICAS_API_URL=/api/metrica-service/v1
